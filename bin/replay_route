#!/usr/bin/env python

r'''Replay route waypoints from a file.
'''

import rclpy
from rclpy.qos import DurabilityPolicy, HistoryPolicy, QoSProfile

# Imports de mensagens necessários
import builtin_interfaces.msg
import geometry_msgs.msg
import nav_msgs.msg
import std_msgs.msg

# Imports para TF (Transformações)
from tf2_ros import TransformException
from tf2_ros.buffer import Buffer
from tf2_ros.transform_listener import TransformListener

from copy import deepcopy
from sys import exit

from roselito_agent.pegar_posicao_robo import pegar_posicao_robo

class ReplayRoute(rclpy.node.Node):
    r'''Replay a route file.
    '''
    def __init__(self):
        r'''Create a new route replayer node.
        '''
        super().__init__('replay_route')
        
        # Declara os parâmetros com valores padrão
        self.declare_parameter('frequency', 10.0)
        self.declare_parameter('global_frame', 'map')
        self.declare_parameter('robot_base_frame', 'base_footprint')
        self.declare_parameter('path', 'route.pon') # Padrão caso o launch falhe
        self.declare_parameter('dist_threshold', 0.5) 

        # Recupera os valores dos parâmetros
        self.__global_frame = self.get_parameter('global_frame').value
        self.__robot_frame = self.get_parameter('robot_base_frame').value
        self.__dist_threshold = self.get_parameter('dist_threshold').value
        path_file = self.get_parameter('path').value

        self.get_logger().info(f"Threshold de distância: {self.__dist_threshold}m")
        self.get_logger().info(f"Tentando ler rota de: {path_file}")

        self.__buffer = Buffer()
        self.__listener = TransformListener(self.__buffer, self)

        # Abertura segura do arquivo (como solicitado)
        try:
            with open(path_file, 'r') as f:
                # O eval converte a string do arquivo de volta para objeto Python
                self.__route = eval(''.join(line.strip() for line in f))
            self.get_logger().info(f'Rota carregada com sucesso! {len(self.__route.poses)} waypoints encontrados.')
        except FileNotFoundError:
            self.get_logger().error(f'ARQUIVO NÃO ENCONTRADO: {path_file}')
            self.get_logger().error('Verifique se o caminho no parâmetro "save_path" está correto no launch file.')
            exit(1)
        except Exception as e:
            self.get_logger().error(f'Erro ao ler/processar o arquivo de rota: {e}')
            exit(1)

        # Atributos de controle de estado
        self.__current_index = 0
        self.__total_poses = len(self.__route.poses)

        self.__pub_goal = self.create_publisher(geometry_msgs.msg.PoseStamped, '/goal_pose', 1)

        period = 1.0 / self.get_parameter('frequency').value
        self.__timer = self.create_timer(period, self.__callback)

    def __callback(self):
        # Verifica se a rota terminou
        if self.__current_index >= self.__total_poses:
            self.get_logger().info('Fim da rota atingido com sucesso!')
            self.__timer.cancel()
            exit(0)

        # Pega a pose atual do robô
        current_pose = pegar_posicao_robo(
            self, 
            self.__buffer, 
            self.__global_frame, 
            self.__robot_frame
        )
        if current_pose is None:
            return # Aguarda o TF ficar disponível

        # Pega o alvo atual (usa deepcopy para não alterar o original da lista)
        target_pose = deepcopy(self.__route.poses[self.__current_index])

        # Cálculo de distância Euclidiana 2D
        dx = target_pose.pose.position.x - current_pose.pose.position.x
        dy = target_pose.pose.position.y - current_pose.pose.position.y
        distance = (dx**2 + dy**2)**0.5

        # Lógica de progressão ou publicação
        if distance < self.__dist_threshold:
            self.get_logger().info(f'Waypoint {self.__current_index} atingido! (Dist: {distance:.2f}m)')
            self.__current_index += 1
        else:
            # Atualiza o timestamp para o tempo real antes de enviar para o Nav2
            target_pose.header.stamp = self.get_clock().now().to_msg()
            self.__pub_goal.publish(target_pose)

def main():
    r'''Start the node.
    '''
    rclpy.init()
    node = ReplayRoute()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        if rclpy.ok():
            rclpy.shutdown()

if __name__ == '__main__':
    main()